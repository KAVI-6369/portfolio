<!DOCTYPE html>
<html>
<head>
  <title>Designing a Web Page</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
    }
    header {
      background-color: #f0f0f0;
      padding: 20px;
      text-align: center;
    }
    nav {
      background-color: #333;
      color: #fff;
      padding: 10px;
      text-align: center;
    }
    nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    nav li {
      display: inline-block;
      margin-right: 20px;
    }
    nav a {
      color: #fff;
      text-decoration: none;
    }
    main {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
    .card {
      background-color: #f0f0f0;
      margin: 20px;
      padding: 20px;
      width: 200px;
    }
    .card img {
      width: 100%;
    }
    footer {
      background-color: #333;
      color: #fff;
      padding: 10px;
      text-align: center;
      clear: both;
    }
  </style>
</head>
<body>
  <header>
    <h1>Designing a Web Page</h1>
  </header>
  <nav>
    <ul>
      <li><a href="#">Home</a></li>
      <li><a href="#">About</a></li>
      <li><a href="#">Contact</a></li>
    </ul>
  </nav>
  <main>
    <div class="card">
      <img src="image1.jpg" alt="Image 1">
      <h2>Card 1</h2>
      <p>This is the first card.</p>
    </div>
    <div class="card">
      <img src="image2.jpg" alt="Image 2">
      <h2>Card 2</h2>
      <p>This is the second card.</p>
    </div>
    <div class="card">
      <img src="image3.jpg" alt="Image 3">
      <h2>Card 3</h2>
      <p>This is the third card.</p>
    </div>
  </main>
  <footer>
    <p>&copy; 2023 Designing a Web Page</p>
  </footer>
</body>
</html>
